<resources>
 <style name="Theme.SheShield" parent="Theme.Material3.DayNight.NoActionBar">
  <item name="colorPrimary">@color/purple_primary</item>
  <item name="colorOnPrimary">@color/surface</item>
  <item name="colorSecondary">@color/risk_low</item>
  <item name="colorOnSecondary">@color/surface</item>
  <item name="colorError">@color/risk_high</item>
  <item name="android:colorBackground">@color/background</item>
  <item name="colorSurface">@color/surface</item>
  <item name="colorOnSurface">@color/on_surface</item>
  <item name="colorOnSurfaceVariant">@color/on_surface_secondary</item>
  <item name="colorSurfaceVariant">@color/surface_variant</item>
  <item name="colorSurfaceContainer">@color/surface</item>
  <item name="colorSurfaceContainerHigh">@color/surface</item>
  <item name="colorSurfaceContainerHighest">@color/surface_variant</item>
  <item name="colorOutline">@color/separator</item>
  <item name="android:statusBarColor">@color/background</item>
  <item name="android:navigationBarColor">@color/background</item>
  <item name="android:windowLightStatusBar">true</item>
  <item name="android:fontFamily">sans-serif</item>
  <item name="android:windowActionModeOverlay">true</item>
  <item name="materialAlertDialogTheme">@style/ThemeOverlay.SheShield.Dialog</item>
  <item name="bottomSheetDialogTheme">@style/ThemeOverlay.SheShield.Sheet</item>
  <item name="android:colorAccent">@color/purple_primary</item>
 </style>
 <style name="ThemeOverlay.SheShield.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
  <item name="colorSurface">@color/surface</item>
  <item name="colorOnSurface">@color/on_surface</item>
  <item name="shapeAppearanceMediumComponent">@style/Shape.SheShield.Dialog</item>
  <item name="shapeAppearanceLargeComponent">@style/Shape.SheShield.Dialog</item>
  <item name="alertDialogStyle">@style/Widget.SheShield.Dialog</item>
  <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.SheShield.DialogTitle</item>
  <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.SheShield.DialogBody</item>
  <item name="android:backgroundDimAmount">0.32</item>
 </style>
 <style name="Widget.SheShield.Dialog" parent="MaterialAlertDialog.Material3">
  <item name="backgroundTint">@color/surface</item>
  <item name="shapeAppearance">@style/Shape.SheShield.Dialog</item>
 </style>
 <style name="Shape.SheShield.Dialog" parent="ShapeAppearance.Material3.Corner.Medium">
  <item name="cornerSize">24dp</item>
 </style>
 <style name="TextAppearance.SheShield.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
  <item name="android:fontFamily">sans-serif-medium</item><item name="android:textSize">21sp</item><item name="android:textColor">@color/on_surface</item>
 </style>
 <style name="TextAppearance.SheShield.DialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
  <item name="android:textSize">16sp</item><item name="android:textColor">@color/on_surface_secondary</item><item name="android:lineSpacingExtra">4dp</item>
 </style>
 <style name="ThemeOverlay.SheShield.Sheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
  <item name="bottomSheetStyle">@style/Widget.SheShield.Sheet</item><item name="android:backgroundDimAmount">0.32</item>
 </style>
 <style name="Widget.SheShield.Sheet" parent="Widget.Material3.BottomSheet.Modal">
  <item name="backgroundTint">@color/surface</item><item name="shapeAppearanceOverlay">@style/Shape.SheShield.Sheet</item>
 </style>
 <style name="Shape.SheShield.Sheet" parent=""><item name="cornerFamily">rounded</item><item name="cornerSizeTopLeft">28dp</item><item name="cornerSizeTopRight">28dp</item></style>
 <style name="TextAppearance.SheShield.Tab" parent="TextAppearance.Material3.LabelSmall"><item name="android:fontFamily">sans-serif-medium</item><item name="android:textSize">11sp</item></style>
 <style name="Theme.SheShield.AppBarOverlay" parent="ThemeOverlay.Material3" />
 <style name="Widget.SheShield.SosButton" parent="Widget.Material3.Button"><item name="backgroundTint">@color/sos_red</item><item name="android:textColor">@color/white</item></style>
 <style name="Widget.SheShield.PrimaryButton" parent="Widget.Material3.Button"><item name="backgroundTint">@color/purple_primary</item><item name="android:textColor">@color/surface</item></style>
</resources>
