# Copy to api/.env. Never commit real credentials.
HOST=0.0.0.0
PORT=8787
DATABASE_PATH=./data/sheshield.sqlite
ORS_API_KEY=
# JSON file containing { incidents: [...], coverage: {...} }; fictional fixtures
# must never be used as live evidence.
INCIDENT_DATA_PATH=
# Exact external HTTPS URL of the API tunnel (no trailing slash).
PUBLIC_BASE_URL=
N8N_WEBHOOK_URL=https://alluvia.app.n8n.cloud/webhook/sheshield-delivery
# Random shared secret, also set in the n8n Header Auth credential.
WORKER_TOKEN=
# Only needed on API for callback signature validation.
TWILIO_AUTH_TOKEN=
# Required for real calls; comma-separated recipients approved for testing.
LIVE_ALERTS_ENABLED=false
TEST_RECIPIENT_ALLOWLIST=
# Optional enrollment code. Required if enrolling through a public tunnel.
ENROLLMENT_CODE=
# Optional incident metadata export from an existing Pinecone serverless index.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=
INCIDENT_SOURCE=
INCIDENT_LICENSE=
# west,south,east,north; describe the actual source coverage, not arbitrary bounds.
INCIDENT_COVERAGE_BOUNDS=
INCIDENT_RECORDS_VERIFIED=false
